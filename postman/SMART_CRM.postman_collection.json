{
  "info": {
    "name": "SMART CRM API",
    "description": "B2B 智能获客面板 API 集合。设置变量 base_url 和 session_token。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "session_token", "value": "" },
    { "key": "batch_id", "value": "" },
    { "key": "session_id", "value": "" },
    { "key": "lead_id", "value": "" },
    { "key": "order_id", "value": "" }
  ],
  "item": [
    {
      "name": "01 Health & Status",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          }
        },
        {
          "name": "Integrations Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/integrations/status"
          }
        },
        {
          "name": "Get Config (masked)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/config"
          }
        },
        {
          "name": "Integrations Probe",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/integrations/probe"
          }
        },
        {
          "name": "System Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has production_blockers', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.production_blockers).to.be.an('object');",
                  "  pm.expect(j.production_blockers.code_complete).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/system/readiness"
          }
        },
        {
          "name": "Pilot Report",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/pilot/report"
          }
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@example.com\",\"portal\":\"admin\"}"
            },
            "url": "{{base_url}}/api/auth/otp/send"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@example.com\",\"code\":\"123456\",\"portal\":\"admin\"}"
            },
            "url": "{{base_url}}/api/auth/otp/verify"
          }
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/auth/session"
          }
        }
      ]
    },
    {
      "name": "03 Brainstorm Lab",
      "item": [
        {
          "name": "Generate Strategy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.session_id) pm.collectionVariables.set('session_id', j.session_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"country_iso\":\"MX\",\"city\":\"CDMX\",\"category_l3\":\"bakeware\",\"language\":\"es\"}"
            },
            "url": "{{base_url}}/api/brainstorm/generate"
          }
        },
        {
          "name": "Enqueue Track A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"session_id\":\"{{session_id}}\",\"action_type\":\"track_a_job\",\"payload\":{}}"
            },
            "url": "{{base_url}}/api/brainstorm/actions"
          }
        }
      ]
    },
    {
      "name": "04 Lead Acquisition",
      "item": [
        {
          "name": "Run Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.batch_id) pm.collectionVariables.set('batch_id', j.batch_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"keyword\":\"mayorista moldes repostería CDMX\",\"industry\":\"跨境电商\",\"count\":3,\"country_iso\":\"MX\",\"city\":\"CDMX\",\"category_l3\":\"bakeware\"}"
            },
            "url": "{{base_url}}/api/run"
          }
        },
        {
          "name": "Get Batch",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/batch/{{batch_id}}"
          }
        },
        {
          "name": "Confirm Lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/confirm/{{lead_id}}"
          }
        }
      ]
    },
    {
      "name": "05 Market Intel & Geo",
      "item": [
        {
          "name": "List Anchors MX",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/market/anchors?country_iso=MX"
          }
        },
        {
          "name": "Geo Config",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/geo/config"
          }
        },
        {
          "name": "KB Search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/kb/search?q=bakeware Mexico&limit=5"
          }
        }
      ]
    },
    {
      "name": "06 Pilot & Content",
      "item": [
        {
          "name": "MX Pilot Start",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"country_iso\":\"MX\",\"category_l3\":\"bakeware\",\"enqueue_track_a\":true}"
            },
            "url": "{{base_url}}/api/pilot/mx/start"
          }
        },
        {
          "name": "Run Due Schedules",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/schedules/run-due?limit=1&count_per_task=5"
          }
        },
        {
          "name": "Content Generate Batch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"content_type\":\"seo_pack\",\"product_name\":\"Bakeware Set\",\"languages\":[\"es\",\"en\",\"pt\"]}"
            },
            "url": "{{base_url}}/api/content/generate-batch"
          }
        },
        {
          "name": "Feishu Test Write",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/integrations/feishu/test-write"
          }
        }
      ]
    },
    {
      "name": "07 Phase 1.5 Dashboard",
      "item": [
        {
          "name": "Stats Overview",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/stats/overview"
          }
        },
        {
          "name": "Outreach Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/outreach/stats"
          }
        },
        {
          "name": "Log WhatsApp Outreach",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"lead_id\":\"{{lead_id}}\",\"channel\":\"whatsapp\",\"country_iso\":\"MX\",\"message_preview\":\"Hola, somos fabricante de moldes.\"}"
            },
            "url": "{{base_url}}/api/outreach/log"
          }
        },
        {
          "name": "List Outreach Logs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/outreach/logs?channel=whatsapp"
          }
        },
        {
          "name": "KB Index Lead",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/kb/index/{{lead_id}}"
          }
        },
        {
          "name": "KB Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/kb/status"
          }
        },
        {
          "name": "KB Search CO Bakeware",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/kb/search?q=bakeware%20MX&limit=5"
          }
        }
      ]
    },
    {
      "name": "08 Phase 1 Employee",
      "item": [
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/leads?limit=20"
          }
        },
        {
          "name": "Catalog Tree",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/catalog/tree"
          }
        },
        {
          "name": "List Factories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/factories"
          }
        },
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.id) pm.collectionVariables.set('order_id', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_name\":\"Demo Hotel Supplies\",\"country_iso\":\"MX\"}"
            },
            "url": "{{base_url}}/api/orders"
          }
        },
        {
          "name": "Add Order Line",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"product_name\":\"Bakeware mould set\",\"sku\":\"BK-001\",\"qty\":100,\"unit_price\":2.5,\"category_l3\":\"bakeware\"}"
            },
            "url": "{{base_url}}/api/orders/{{order_id}}/lines"
          }
        },
        {
          "name": "Admin Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/admin/summary"
          }
        },
        {
          "name": "Feishu Read Record",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/feishu/records/mock-rec-001"
          }
        },
        {
          "name": "Bridge TBCEXP",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/bridge/tbcexp/{{lead_id}}"
          }
        },
        {
          "name": "Order From Lead",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/orders/from-lead/{{lead_id}}"
          }
        },
        {
          "name": "Exa Preview Query",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/exa/preview-query?category_l3=bakeware&country_iso=CO&city=Bogotá"
          }
        }
      ]
    },
    {
      "name": "09 Phase 2 Portal & Catalog",
      "item": [
        {
          "name": "Handoff Report",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/system/handoff-report"
          }
        },
        {
          "name": "List Catalog Documents",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/catalog/documents"
          }
        },
        {
          "name": "List Quote Documents",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/catalog/documents?doc_type=quote"
          }
        },
        {
          "name": "Portal Catalogs (auth)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/portal/catalogs?doc_type=catalog"
          }
        },
        {
          "name": "Portal Quotes (auth)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/portal/quotes"
          }
        },
        {
          "name": "Create Share Link (catalog)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"resource_type\":\"catalog\",\"resource_id\":\"REPLACE_DOC_ID\",\"ttl_days\":7}"
            },
            "url": "{{base_url}}/api/share/links"
          }
        },
        {
          "name": "Apollo Enrich Lead",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/leads/{{lead_id}}/enrich-contact"
          }
        },
        {
          "name": "TBCEXP List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/bridge/tbcexp/orders"
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"confirmed\"}"
            },
            "url": "{{base_url}}/api/orders/{{order_id}}"
          }
        }
      ]
    },
    {
      "name": "10 Phase 3 Files & Notify",
      "item": [
        {
          "name": "List File Transfers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/files/transfers"
          }
        },
        {
          "name": "Create File Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Packaging ZIP\",\"customer_email\":\"customer@example.com\",\"file_size_mb\":45,\"content_type\":\"application/zip\"}"
            },
            "url": "{{base_url}}/api/files/transfers"
          }
        },
        {
          "name": "File Upload URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"update_file_url\":true}"
            },
            "url": "{{base_url}}/api/files/transfers/REPLACE_FILE_ID/upload-url"
          }
        },
        {
          "name": "Create Share Link (file + notify)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"resource_type\":\"file\",\"resource_id\":\"REPLACE_FILE_ID\",\"customer_email\":\"customer@example.com\",\"notify_email\":true,\"notify_message\":\"您的文件已就绪\",\"ttl_days\":14}"
            },
            "url": "{{base_url}}/api/share/links"
          }
        }
      ]
    },
    {
      "name": "11 Phase 4 Prepress AI",
      "item": [
        {
          "name": "List Prepress Reviews",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/prepress/reviews"
          }
        },
        {
          "name": "Validate Barcode",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"value\":\"5901234123457\",\"symbology\":\"ean13\"}"
            },
            "url": "{{base_url}}/api/prepress/barcode/validate"
          }
        },
        {
          "name": "Run Prepress Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/prepress/reviews/REPLACE_REVIEW_ID/run"
          }
        }
      ]
    },
    {
      "name": "12 Phase 5 Production Inspect",
      "item": [
        {
          "name": "List Production Inspections",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/inspections/production"
          }
        },
        {
          "name": "Run Production Inspection",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/inspections/production/REPLACE_INSP_ID/run"
          }
        },
        {
          "name": "Human Review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{session_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"human_review_status\":\"approved\",\"human_review_notes\":\"OK\"}"
            },
            "url": "{{base_url}}/api/inspections/production/REPLACE_INSP_ID/review"
          }
        }
      ]
    },
    {
      "name": "13 ERP Bridge",
      "item": [
        {
          "name": "Field Map",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/bridge/tbcexp/field-map"
          }
        },
        {
          "name": "List ERP Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/bridge/tbcexp/orders?limit=10"
          }
        },
        {
          "name": "Sync ERP Orders",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/bridge/tbcexp/orders/sync?limit=10"
          }
        },
        {
          "name": "Push Lead to ERP",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
            "url": "{{base_url}}/api/bridge/tbcexp/{{lead_id}}"
          }
        }
      ]
    },
    {
      "name": "14 v2.1 Incremental",
      "item": [
        {
          "name": "Tus Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/files/tus/status"
          }
        },
        {
          "name": "OCR Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/prepress/ocr/status"
          }
        },
        {
          "name": "Barcode Scan Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/prepress/barcode/scan/status"
          }
        }
      ]
    }
  ]
}
