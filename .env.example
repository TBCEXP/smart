# 复制为 /opt/smart-crm/.env 后修改（docker compose 自动读取）

# 必填
SESSION_SECRET=change-me-to-random-32-chars-min
APP_BASE_URL=https://crm.yourdomain.com

# 应用版本（health 显示）
VERSION=2.1.0

# Docker 镜像标签（部署时可用 git SHA）
# IMAGE_TAG=latest
# BUILD_SHA=

# 数据库（默认 compose 内 Postgres；本地开发可用 SQLite）
# DATABASE_URL=postgresql+asyncpg://smartcrm:smartcrm@postgres:5432/smartcrm
# SYNC_DATABASE_URL=postgresql://smartcrm:smartcrm@postgres:5432/smartcrm
# USE_SQLITE=1

# 以下也可在 Tab2 面板配置（写入 data/config.json）
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# OPENAI_API_KEY=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TABLE_ID=
# RESEND_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=smart-crm
# TBCEXP_API_URL=
# TBCEXP_API_TOKEN=
